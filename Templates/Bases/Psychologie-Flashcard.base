filters:
  and:
    - categories.contains(link("Psychologie-Flashcard"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  created:
    displayName: Created
  file.ctime:
    displayName: File Created
  file.mtime:
    displayName: Modified
  tags:
    displayName: Tags
views:
  - type: table
    name: All
    order:
      - file.name
      - tags
      - categories
    sort:
      - property: file.mtime
        direction: DESC
    columnSize:
      file.name: 430
  - type: cards
    name: Cards
    order:
      - file.name
      - created
    sort:
      - property: file.mtime
        direction: DESC
    coverProperty: cover
